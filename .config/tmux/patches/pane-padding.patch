diff --git a/regress/pane-padding.sh b/regress/pane-padding.sh
new file mode 100755
index 00000000..2b45a4ac
--- /dev/null
+++ b/regress/pane-padding.sh
@@ -0,0 +1,92 @@
+#!/bin/sh
+
+# pane-padding: verify symmetric content padding geometry.
+# Covers: zero padding, padding 2, narrow panes, horizontal split,
+# vertical split, and scrollbar coexistence.
+
+PATH=/bin:/usr/bin
+TERM=screen
+
+[ -z "$TEST_TMUX" ] && TEST_TMUX="$PWD/../tmux"
+TMUX="$TEST_TMUX -Lpadtest -f/dev/null"
+$TMUX kill-server 2>/dev/null
+
+fail=0
+check() {
+	# $1 = expected, $2 = actual, $3 = label
+	if [ "$1" != "$2" ]; then
+		echo "FAIL: $3: expected $1 got $2"
+		fail=1
+	fi
+}
+
+# Single 80x24 pane, no padding (stock geometry).
+$TMUX new-session -d -x80 -y24 -s t
+w=$($TMUX display-message -p -t t '#{pane_width}')
+l=$($TMUX display-message -p -t t '#{pane_left}')
+check 80 "$w" "stock width"
+check 0 "$l" "stock left"
+
+# padding 2: content shrinks by 4, offset shifts by 2.
+$TMUX set -g pane-padding 2
+w=$($TMUX display-message -p -t t '#{pane_width}')
+l=$($TMUX display-message -p -t t '#{pane_left}')
+check 76 "$w" "pad2 width"
+check 2 "$l" "pad2 left"
+
+# Out of range is rejected by the option table (max 20).
+$TMUX set -g pane-padding 99 2>/dev/null && fail=1
+v=$($TMUX show-options -g pane-padding)
+check "pane-padding 2" "$v" "range clamp keeps prior"
+
+# Horizontal split: both panes keep content >= PANE_MINIMUM and offsets shift.
+$TMUX set -g pane-padding 3
+$TMUX split-window -h -t t
+$TMUX list-panes -t t -F '#{pane_index}:#{pane_width}:#{pane_left}' > /tmp/.pp_h
+n=$(wc -l < /tmp/.pp_h | tr -d ' ')
+check 2 "$n" "hsplit count"
+# Every content width is at least PANE_MINIMUM (1) and offset >= padding.
+awk -F: '{ if ($2 < 1) exit 1; if ($3 < 3) exit 2 }' /tmp/.pp_h || fail=1
+
+# Vertical split: heights split, widths unaffected by vertical split.
+$TMUX split-window -v -t t:0.0
+$TMUX list-panes -t t -F '#{pane_index}:#{pane_width}:#{pane_height}' > /tmp/.pp_v
+n=$(wc -l < /tmp/.pp_v | tr -d ' ')
+check 3 "$n" "vsplit count"
+awk -F: '{ if ($2 < 1 || $3 < 1) exit 1 }' /tmp/.pp_v || fail=1
+
+# Scrollbar coexistence with padding: no crash, content still >= PANE_MINIMUM.
+$TMUX set -g pane-scrollbars on
+$TMUX set -g pane-scrollbars-position right
+$TMUX list-panes -t t -F '#{pane_width}:#{pane_left}' > /tmp/.pp_sb
+awk -F: '{ if ($1 < 1) exit 1 }' /tmp/.pp_sb || fail=1
+$TMUX set -g pane-scrollbars-position left
+$TMUX list-panes -t t -F '#{pane_width}:#{pane_left}' >/dev/null || fail=1
+
+# Narrow panes: large padding clamps so content stays >= PANE_MINIMUM.
+$TMUX set -g pane-padding 10
+$TMUX resize-window -t t -x12 -y10
+$TMUX list-panes -t t -F '#{pane_width}' > /tmp/.pp_narrow
+awk '{ if ($1 < 1) exit 1 }' /tmp/.pp_narrow || fail=1
+
+# Resize a pane: no crash, content still valid.
+$TMUX resize-window -t t -x40 -y10
+$TMUX resize-pane -t t:0.0 -R 4
+$TMUX list-panes -t t -F '#{pane_width}' >/dev/null || fail=1
+
+# padding 0 restores stock geometry (single pane).
+$TMUX kill-pane -t t:0.1 2>/dev/null
+$TMUX kill-pane -t t:0.1 2>/dev/null
+$TMUX set -g pane-padding 0
+$TMUX set -g pane-scrollbars off
+$TMUX resize-window -t t -x80 -y24
+w=$($TMUX display-message -p -t t '#{pane_width}')
+l=$($TMUX display-message -p -t t '#{pane_left}')
+check 80 "$w" "restore width"
+check 0 "$l" "restore left"
+
+$TMUX kill-server 2>/dev/null
+rm -f /tmp/.pp_h /tmp/.pp_v /tmp/.pp_sb /tmp/.pp_narrow
+[ "$fail" = 0 ] && echo "pane-padding: all checks passed" && exit 0
+echo "pane-padding: FAILED"
+exit 1
