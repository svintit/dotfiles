class Pane:
    def __init__(self, parts):
        (
            self.session,
            self.window_index,
            self.window_name,
            self.pane_index,
            self.pane_id,
            self.pane_pid,
            self.title,
            self.command,
            self.path,
            self.pi_name,
            self.pi_status,
            self.joust_active_until,
            self.slack_user,
            self.manual_unread,
            self.sidebar_kind,
            self.pane_active,
            self.window_active,
            self.session_attached,
            self.session_last_attached,
            self.freeze_state,
            self.freeze_resume_id,
            self.freeze_cwd,
            self.freeze_last_activity,
            self.freeze_summary,
            self.frozen_at,
            self.freeze_prompt_active,
            self.freeze_resume_started,
        ) = parts
        # Set by assign_numbers(); drives the ctrl+<n> jump bindings.
        self.number = None
        self.suppress_completed = False
        self.live_omp = False
        self.screen_busy = False
    @property
    def is_sidebar(self):
        return self.sidebar_kind == SIDEBAR_KIND or self.title == SIDEBAR_TITLE

    @property
    def has_pi_metadata(self):
        return bool(
            self.pi_name
            or self.pi_status
            or self.slack_user
            or self.freeze_state
            or self.joust_active_until
        )

    @property
    def is_pi_pane(self):
        # Pi/OMP natively set the pane title to "π - <name> - <dir>" (pi)
        # or "π: <name>" (omp), so we can detect sessions without any
        # custom extension metadata.
        return (self.title or "").startswith(("π ", "π:", "π-"))

    @property
    def is_agentish(self):
        return self.command in AGENT_COMMANDS

    @property
    def is_current(self):
        return (
            self.pane_active == "1"
            and self.window_active == "1"
            and self.session_attached not in ("", "0")
        )

    @property
    def is_frozen(self):
        if self.live_omp:
            return False
        return self.freeze_state in {"freezing", "frozen"}

    @property
    def is_resuming(self):
        return self.freeze_state == "resuming"


    @property
    def native_title_busy(self):
        title = self.title or ""
        return (
            len(title) >= 3
            and title.startswith("π ")
            and title[2] in NATIVE_TITLE_SPINNER_FRAMES
        )


    @property
    def joust_active(self):
        try:
            return int(self.joust_active_until) > int(time.time() * 1000)
        except (TypeError, ValueError):
            return False


    @property
    def display_status(self):
        if self.is_frozen:
            return "frozen"
        if self.is_resuming:
            return "working"
        status = (self.pi_status or "").strip().lower()
        if (self.native_title_busy or self.screen_busy) and status in {"", "done", "completed", "complete", "idle", "stopped", "error", "errored", "aborted"}:
            return "working"
        if self.joust_active and not (self.native_title_busy or self.screen_busy):
            return "subagent_working"
        if self.suppress_completed and status in {"done", "completed", "complete"}:
            return "working"
        if status == "asking":
            return "asking"
        if status in {"clock"}:
            return "working"
        if status in {"working", "running"}:
            return "working"
        if status in {"done", "completed", "complete"}:
            return "done"
        if status in {"blocked", "needs_input", "waiting"}:
            return "blocked"
        if status in {"stopped", "error", "errored", "aborted"}:
            return "stopped"
        if status in {"idle"}:
            return "idle"
        return "unknown"

    @property
    def source_label(self):
        """The cleaned label to AI-shorten, or None when there is nothing to
        shorten (slack handle, bare shell, or the no-name dir fallback)."""
        if self.slack_user:
            return None
        # Prefer the pane title: for pi (π - <name> - <dir>) and omp (π: <name>)
        # it carries the full name, while @pi_session_name is truncated by pi.
        # The 2-part "π - <dir>" title (no name) collapses to "-" via clean_label.
        # omp uses "π > <name>" (pi uses "π - <name> - <dir>"); both carry
        # the full session name, while @pi_session_name is truncated.
        if self.title and (self.title.startswith(("π: ", "π - ", "π- ", "π > "))):
            return clean_label(self.title) or None
        if self.pi_name:
            return clean_label(self.pi_name)
        if self.title and self.title not in {"fish", "bash", "zsh", "node", "pi"}:
            return clean_label(self.title) or None
        return None

    @property
    def context(self):
        if self.slack_user:
            return "@" + clean_token(self.slack_user, 32)
        label = self.source_label
        if label is None:
            return f"pane {self.pane_index}"
        if label in LITERAL_LABELS:
            return label
        # Use the AI-regenerated short name from the cache when available;
        # otherwise return the full label and let truncate() handle width.
        if label in _ai_name_cache:
            return _ai_name_cache[label]
        return label

    @property
    def target(self):
        return f"{self.session}:{self.window_index}.{self.pane_index}"


