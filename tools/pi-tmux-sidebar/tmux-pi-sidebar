            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            waiting_ids = set()
            for pane in panes:
                if pane.live_omp or not pane.is_frozen:
                    continue
                active = pane.freeze_prompt_active
                if active.startswith("waiting:"):
                    waiting_ids.add(pane.pane_id)
                    try:
                        fish_pid = int(active.split(":", 1)[1])
                        os.kill(fish_pid, 0)
                    except (OSError, ValueError):
                        pass
                    else:
                        summary = pane.freeze_summary or pane.pi_name
                        visible = (
                            pane.window_active == "1"
                            and pane.session_attached not in ("", "0")
                        )
                        elapsed = _frozen_elapsed_display(pane.frozen_at)
                        sig = (fish_pid, summary, elapsed, visible)
                        cached = _frozen_redraw_cache.get(pane.pane_id)
                        _frozen_redraw_cache[pane.pane_id] = sig
                        if cached != sig and visible:
                            os.kill(fish_pid, signal.SIGWINCH)
                        continue
                try:
                    if active and now_ms - int(active) < FREEZE_PROMPT_RETRY_MS:
                        continue
                except ValueError:
                    pass
                set_pane_option(pane, "@pi_freeze_prompt_active", str(now_ms))
                try:
                    subprocess.run(
                        tmux_command(
                            "send-keys",
                            "-t",
                            pane.pane_id,
                            "-l",
                            FREEZE_PROMPT_COMMAND + "\r",
                        ),
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=1,
                        check=False,
                    )
                except Exception:
                    set_pane_option(pane, "@pi_freeze_prompt_active", "")
            for pid in list(_frozen_redraw_cache):
                if pid not in waiting_ids:
                    del _frozen_redraw_cache[pid]
    except Exception:
        pass

def keep_sidebar_pane(pane):
    # OMP panes keep a resume ID after normal exit. Show them only while the
    # process is live or the pane has an explicit freeze/resume state.
    if not pane.freeze_resume_id:
        return True
    if pane.live_omp or pane.freeze_state in {"freezing", "frozen", "resuming"}:
        return True
    # Dead OMP pane with a resume ID: still show it if Pi metadata or a pi
    # title is present so the session stays visible and clickable for resume.
    return pane.has_pi_metadata or pane.is_pi_pane


def fetch_pane_state():
    panes = tmux_list_panes()
    live_detection_ok = reconcile_frozen_state(panes)
    detect_screen_busy(panes)
    if live_detection_ok:
        sync_frozen_registry(panes)
        ensure_frozen_prompts(panes)
    panes = [pane for pane in panes if keep_sidebar_pane(pane)]
    stabilize_completed_status(panes)
    load_ai_name_cache()
    queue_ai_names(panes)
    color_map = sesh_colour_map([pane.session for pane in panes])
    grouped = group_panes(panes)
    ordered = assign_numbers(grouped)
    numbers = {str(pane.number): pane.pane_id for pane in ordered}
    if TARGET_CLIENT:
        selected_pane_id = fetch_selected_pane_id()
    else:
        current_panes = [p for p in panes if p.is_current]
        selected = max(current_panes, key=lambda p: int(p.session_last_attached or 0), default=None)
        selected_pane_id = selected.pane_id if selected else None
    unread = update_unread_state(panes, selected_pane_id, numbers)
    return panes, color_map, grouped, selected_pane_id, unread


def render_expanded(width, height, state=None):
    global CLICK_TARGETS, SESSION_BUTTON_TARGETS
    CLICK_TARGETS = {}
    SESSION_BUTTON_TARGETS = {}
    # Keep the true pane width; the selected-row highlight spans it edge to edge.
    pane_width = max(width, LEFT_MARGIN + RIGHT_MARGIN + 10)
    width = max(10, width - RIGHT_MARGIN - LEFT_MARGIN)
    if state is None:
        state = fetch_pane_state()
    panes, color_map, grouped, selected_pane_id, unread = state

    lines = []
    for hline in header_lines(width):
        lines.append((hline, None, None))
    lines.append(("", None, None))

    if len(panes) == 0:
        lines.append((f"{DIM}no active pi panes{RESET}", None, None))
    else:
        for session_index, (session, session_panes) in enumerate(grouped.items()):

            session_colour = color_map.get(session)
            sesh_style = f"\033[38;5;{session_colour}m" if session_colour is not None else CYAN
            all_frozen = bool(session_panes) and all(pane.is_frozen for pane in session_panes)
            border_style = FROZEN_BORDER if all_frozen else sesh_style
            title_style = FROZEN_TEXT if all_frozen else sesh_style
            title_weight = "" if all_frozen else "\033[1m"
            inner_width = width - 2  # space between left │ and right │ borders
            if inner_width < 4:
                lines.append((session_header_line(session, session_panes, width, color_map), None, None))
                for pane in session_panes:
                    is_unread = bool(unread.get(pane.pane_id, False))
                    is_selected = pane.pane_id == selected_pane_id
                    bg = tinted_bg(session_colour) if is_selected else None
                    for row_line in row_lines_for_pane(pane, width, is_unread=is_unread, is_selected=is_selected):
                        lines.append((fit(row_line, width), pane, bg))
                continue

            button = SESSION_NEW_BUTTON
            button_width = len(button)  # Use ASCII cells to keep popup compositing stable.
            count_str = f"({len(session_panes)})" if len(session_panes) > 1 else ""
            count_width = 1 + len(count_str) if count_str else 0
            gap_width = 1 if inner_width >= button_width + 4 else 0
            button_gap_width = 1 if inner_width >= button_width + 5 else 0
            trailing_gap_width = 3 if inner_width >= button_width + 7 else button_gap_width
            if (
                inner_width
                - 2
                - count_width
                - gap_width
                - button_gap_width
                - trailing_gap_width
                - button_width
                < 1
            ):
                count_str = ""
                count_width = 0
            label = truncate(
                session,
                max(
                    1,
                    inner_width
                    - 2
                    - count_width
                    - gap_width
                    - button_gap_width
                    - trailing_gap_width
                    - button_width,
                ),
            )
            top_parts = [f"{border_style}─ {RESET}", f"{title_weight}{title_style}{label}{RESET}"]
            if count_str:
                top_parts.append(f" {DIM}{count_str}{RESET}")
            used = 2 + len(label) + count_width + gap_width
            filler_width = max(
                0,
                inner_width - used - button_gap_width - button_width - trailing_gap_width,
            )
            if gap_width:
                top_parts.append(" ")
            if filler_width:
                top_parts.append(f"{border_style}{'─' * filler_width}{RESET}")
            if button_gap_width:
                top_parts.append(" ")
            top_parts.append(f"{border_style}{button}{RESET}")
            if trailing_gap_width:
                top_parts.append(" ")
                if trailing_gap_width > 1:
                    top_parts.append(f"{border_style}{'─' * (trailing_gap_width - 1)}{RESET}")
            top_content = "".join(top_parts)
            active_pane = next((pane for pane in session_panes if pane.is_current), session_panes[0])
            button_start = LEFT_MARGIN + 2 + inner_width - trailing_gap_width - button_width
            button_end = button_start + button_width - 1
            new_window_target = ("new-window", session, active_pane.path, button_start, button_end)
            lines.append((f"{border_style}┌{RESET}{top_content}{border_style}┐{RESET}", new_window_target, None))

            for pane in session_panes:
                is_unread = bool(unread.get(pane.pane_id, False))
                is_selected = pane.pane_id == selected_pane_id
                for row_line in row_lines_for_pane(pane, inner_width, is_unread=is_unread, is_selected=is_selected):
                    row_fitted = fit(row_line, inner_width)
                    inner = pad_visible(row_fitted, inner_width)
                    if is_selected:
                        # Band fills the inner region only. The `│` glyph is
                        # drawn mid-cell, so tinting the border cell would put
                        # background on the far side of the line and read as
                        # overshoot. Ending at the last inner column sits the
                        # band flush against both borders.
                        bg = tinted_bg(session_colour)
                        inner = bg + inner.replace(RESET, RESET + bg) + RESET
                    lines.append((f"{border_style}│{RESET}{inner}{border_style}│{RESET}", pane, None))

            lines.append((f"{border_style}└{'─' * inner_width}┘{RESET}", None, None))

    footer = []
    content_lines = [(fit(line, width), target_pane, bg) for line, target_pane, bg in lines]
    footer_lines = [(fit(line, width), None, None) for line in footer]

    body_height = max(1, height - TOP_MARGIN)
    footer_height = min(len(footer_lines), body_height)
    content_height = max(0, body_height - footer_height)
    clipped = content_lines[:content_height]
    while len(clipped) < content_height:
        clipped.append(("", None, None))
    clipped.extend(footer_lines[-footer_height:])
    out = [HIDE_CURSOR]
    # Clear top margin rows
    for r in range(1, TOP_MARGIN + 1):
        out.append(f"\033[{r};1H\033[K")
    pad = " " * LEFT_MARGIN
    for row, (line, target_pane, bg) in enumerate(clipped, start=1):
        if isinstance(target_pane, Pane):
            CLICK_TARGETS[row] = target_pane
        elif isinstance(target_pane, tuple) and target_pane[0] == "new-window":
            SESSION_BUTTON_TARGETS[row] = target_pane[1:]
        if bg:
            filled = bg + pad + line.replace(RESET, RESET + bg)
            filled = pad_visible(filled, pane_width)
            out.append(f"\033[{row + TOP_MARGIN};1H{filled}{RESET}\033[K")
        else:
            out.append(f"\033[{row + TOP_MARGIN};1H{pad}{line}{RESET}\033[K")
    return "".join(out)


def collapsed_row_line(pane, width, is_unread, is_selected):
    """Compact row: session number on the left, status icon on the right."""
    icon, color, _label = status_icon(pane.display_status)
    number = str(pane.number or "?")
    if is_selected:
        num_style = NUM_SELECTED
    elif is_unread:
        num_style = BLUE
    else:
        num_style = NUM
    if width >= 4:
        number = number.rjust(2)
    return f"{num_style}{number}{RESET} {color}{icon}{RESET}"


def render_collapsed(width, height, state=None):
    """Narrow handle: expand button, then one numbered row per session.

    Uses the same LEFT_MARGIN/RIGHT_MARGIN insets as the expanded view so the
    whitespace on each side of the content matches in both modes.
    """
    global CLICK_TARGETS, SESSION_BUTTON_TARGETS
    CLICK_TARGETS = {}
    SESSION_BUTTON_TARGETS = {}
    if state is None:
        state = fetch_pane_state()
    _panes, color_map, grouped, selected_pane_id, unread = state
    ordered = [pane for session_panes in grouped.values() for pane in session_panes]
    inner_width = max(1, width - LEFT_MARGIN - RIGHT_MARGIN)
    # Expand button right-aligned in the content column, mirroring the
    # collapse button in the expanded header.
    button = EXPAND_BUTTON if inner_width >= len(EXPAND_BUTTON) else "»"
    button_pad = " " * max(0, inner_width - len(button))
    rows = [
        (f"{button_pad}{GREEN}{button}{RESET}", None, None),
        ("", None, None),
    ]
    for pane in ordered:
        is_unread = bool(unread.get(pane.pane_id, False))
        is_selected = pane.pane_id == selected_pane_id
        bg = tinted_bg(color_map.get(pane.session)) if is_selected else None
        rows.append((collapsed_row_line(pane, inner_width, is_unread, is_selected), pane, bg))
    out = [HIDE_CURSOR]
    for r in range(1, TOP_MARGIN + 1):
        out.append(f"\033[{r};1H\033[K")
    pad = " " * LEFT_MARGIN
    body_height = max(1, height - TOP_MARGIN)
    visible = rows[:body_height]
    for row, (line, target_pane, bg) in enumerate(visible, start=1):
        if target_pane is not None:
            CLICK_TARGETS[row] = target_pane
        if bg:
            # Highlight spans the full pane width, edge to edge.
            filled = bg + pad + line.replace(RESET, RESET + bg)
            filled = pad_visible(filled, width)
            out.append(f"\033[{row + TOP_MARGIN};1H{filled}{RESET}\033[K")
        else:
            out.append(f"\033[{row + TOP_MARGIN};1H{pad}{line}{RESET}\033[K")
    # Clear leftover rows below the list without a full-screen clear (no flicker).
    if len(visible) < body_height:
        out.append(f"\033[{len(visible) + 1 + TOP_MARGIN};1H\033[J")
    return "".join(out)


def render(width, height, state=None):
    if MODE == "collapsed":
        return render_collapsed(width, height, state)
    return render_expanded(width, height, state)


def redraw(use_cache=False):
    global needs_redraw, _pane_state
    needs_redraw = False
    try:
        size = os.get_terminal_size(sys.stdout.fileno())
        width = max(3 if MODE == "collapsed" else 10, size.columns)
        height = max(3, size.lines)
        if not use_cache or _pane_state is None:
            _pane_state = fetch_pane_state()
        if MODE == "expanded":
            frame = render_expanded(width, height, _pane_state)
        else:
            frame = render_collapsed(width, height, _pane_state)
        # Commit the complete sidebar frame atomically. Without this, tmux can
        # interleave partial sidebar paints with the active pane's cursor mode.
        sys.stdout.write("\033[?2026h" + frame + "\033[?2026l")
        sys.stdout.flush()
    except Exception:
        pass


def sidebar_action():
    global running
    running = False
    action = "expand" if MODE == "collapsed" else "collapse"
    try:
        subprocess.Popen(
            [SIDEBAR_CONTROL, action],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass


def live_tmux_client(preferred=""):
    try:
        result = subprocess.run(
            tmux_command("list-clients", "-F", "#{client_name}\t#{client_activity}"),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
        if result.returncode != 0:
            return ""
        clients = []
        for line in result.stdout.splitlines():
            name, _, activity = line.partition("\t")
            if not name:
                continue
            try:
                clients.append((name, int(activity or 0)))
            except ValueError:
                clients.append((name, 0))
        names = {name for name, _activity in clients}
        if preferred and preferred in names:
            return preferred
        return max(clients, key=lambda item: item[1], default=("", 0))[0]
    except Exception:
        return ""


def set_pane_option(pane, key, value):
    args = tmux_command("set-option", "-p", "-t", pane.pane_id, key, value)
    try:
        subprocess.run(
            args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1,
            check=False,
        )
    except Exception:
        pass


def record_pane_interaction(pane):
    set_pane_option(pane, "@pi_freeze_last_activity", str(int(time.time() * 1000)))




def launch_omp_in_pane(pane_id):
    def send_command():
        try:
            subprocess.run(
                tmux_command(
                    "send-keys",
                    "-t",
                    pane_id,
                    "-l",
                    'omp --cwd "$PWD"; source ~/.config/fish/functions/__omp_resume_once.fish; source ~/.config/fish/functions/__pi_freeze_prompt.fish; __pi_freeze_prompt\r',
                ),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=1,
                check=False,
            )
        except Exception:
            pass

    timer = threading.Timer(0.35, send_command)
    timer.daemon = True
    timer.start()


def create_session_window(session, cwd):
    try:
        target_cwd = cwd or os.path.expanduser("~")
        window_name = os.path.basename(os.path.normpath(target_cwd)) or session
        if os.path.normpath(target_cwd) == os.path.normpath(os.path.expanduser("~")):
            window_name = "~"
        result = subprocess.run(
            tmux_command(
                "new-window", "-d", "-P",
                "-F", "#{session_name}:#{window_index}\t#{pane_id}",
                "-t", f"{session}:", "-c", target_cwd, "-n", window_name,
            ),
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        target, separator, pane_id = result.stdout.strip().partition("\t")
        if result.returncode != 0 or not separator or not target or not pane_id:
            return
        launch_omp_in_pane(pane_id)
        client = live_tmux_client(os.environ.get("PI_SIDEBAR_CLIENT", ""))
        if not client:
            return
        subprocess.run(
            tmux_command("switch-client", "-c", client, "-t", session),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1,
            check=False,
        )
        subprocess.run(
            tmux_command("select-window", "-t", target),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1,
            check=False,
        )
    except Exception:
        pass


def sidebar_pid_for_window(pane):
    try:
        result = subprocess.run(
            tmux_command(
                "list-panes",
                "-t",
                f"{pane.session}:{pane.window_index}",
                "-F",
                "#{@pi_sidebar_kind}\t#{@pi_sidebar_pid}",
            ),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
        for line in result.stdout.splitlines():
            kind, _, pid = line.partition("\t")
            if kind == SIDEBAR_KIND and pid.isdigit():
                return int(pid)
        result = subprocess.run(
            tmux_command("show-option", "-gqv", "@pi_sidebar_external_pid"),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
        pid = result.stdout.strip()
        if pid.isdigit():
            return int(pid)
    except Exception:
        pass
    return None


def jump_to_pane(pane, wait=False):
    if pane is None:
        return
    record_pane_interaction(pane)
    # Frozen panes only receive focus. Their shell prompt waits for Enter.
    if pane.is_frozen:
        marker = pane_option(pane, "@pi_freeze_prompt_active")
        if marker.startswith("waiting:"):
            try:
                os.kill(int(marker.split(":", 1)[1]), signal.SIGWINCH)
            except (OSError, ValueError):
                pass
    sidebar_pid = sidebar_pid_for_window(pane)
    publish_selected_hint(pane.pane_id)
    if sidebar_pid is not None:
        try:
            os.kill(sidebar_pid, signal.SIGUSR1)
        except OSError:
            pass
    client = live_tmux_client(os.environ.get("PI_SIDEBAR_CLIENT", ""))
    session = shlex.quote(pane.session)
    window = shlex.quote(f"{pane.session}:{pane.window_index}")
    pane_id = shlex.quote(pane.pane_id)
    client_switch = f" -c {shlex.quote(client)}" if client else ""
    command = f"{TMUX_SHELL} switch-client{client_switch} -t {session}; {TMUX_SHELL} select-window -t {window}; {TMUX_SHELL} select-pane -t {pane_id}; {TMUX_SHELL} refresh-client -S"
    try:
        if wait:
            subprocess.run(
                ["/bin/sh", "-lc", command],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
        else:
            subprocess.Popen(
                ["/bin/sh", "-lc", command],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
    except Exception:
        pass


def resolve_jump_target(number):
    """Prefer the number map the sidebar actually rendered, so a keypress lands
    on the row the user is looking at. Fall back to live order when no sidebar
    has published a map yet."""
    panes = tmux_list_panes()
    pane_id = load_number_map().get(str(number))
    if pane_id:
        for pane in panes:
            if pane.pane_id == pane_id:
                return pane
    ordered = assign_numbers(group_panes(panes))
    if 1 <= number <= len(ordered):
        return ordered[number - 1]
    return None


def jump_to_number(number):
    jump_to_pane(resolve_jump_target(number), wait=True)


def _terminal_session_map(pane_ids):
    """Build {pane_id: (agent, session_file)} from omp/pi terminal-sessions dirs."""
    result = {}
    for agent, base in [("omp", "~/.omp/agent/terminal-sessions"),
                        ("pi", "~/.pi/agent/terminal-sessions")]:
        base_path = os.path.expanduser(base)
        try:
            names = os.listdir(base_path)
        except OSError:
            continue
        for name in names:
            if not name.startswith("tmux-%"):
                continue
            pid = name[5:]
            if pid not in pane_ids:
                continue
            try:
                with open(os.path.join(base_path, name), "r", encoding="utf-8") as fh:
                    lines = fh.read().splitlines()
                    if len(lines) >= 2 and lines[1]:
                        result[pid] = (agent, lines[1])
            except OSError:
                continue
    return result


def snapshot_all_panes():
    """Lightweight snapshot of all non-sidebar panes for closed-pane tracking."""
    fmt = "\t".join([
        "#{pane_id}",
        "#{session_name}",
        "#{pane_current_path}",
        "#{pane_current_command}",
        "#{pane_title}",
        "#{@pi_session_name}",
        "#{@pi_agent_status}",
        "#{@pi_sidebar_kind}",
    ])
    try:
        result = subprocess.run(
            tmux_command("list-panes", "-a", "-F", fmt),
            capture_output=True, text=True, timeout=0.8, check=False,
        )
    except Exception:
        return {}
    if result.returncode != 0:
        return {}
    rows = []
    for line in result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 8:
            continue
        rows.append(parts)
    ts_map = _terminal_session_map({r[0] for r in rows})
    snap = {}
    for pane_id, session, cwd, command, title, pi_name, pi_status, sb_kind in rows:
        if sb_kind == SIDEBAR_KIND or title == SIDEBAR_TITLE:
            continue
        if session.startswith("_"):
            continue
        agent, session_file = ts_map.get(pane_id, (None, None))
        if not agent and (pi_name or pi_status or (title or "").startswith("\u03c0")):
            agent = "omp"
        snap[pane_id] = {
            "cwd": cwd,
            "command": command,
            "title": title,
            "session_name": pi_name or "",
            "agent": agent,
            "session_file": session_file,
            "closed_at": time.time(),
        }
    return snap


def track_closed_panes():
    """Diff current panes vs previous snapshot; record disappeared panes."""
    global _prev_pane_snapshot
    current = snapshot_all_panes()
    disappeared = [
        info for pid, info in _prev_pane_snapshot.items()
        if pid not in current
    ]
    _prev_pane_snapshot = current
    if not disappeared:
        return
    try:
        with open(CLOSED_PANES_LOCK, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                with open(CLOSED_PANES_FILE, "r", encoding="utf-8") as fh:
                    stack = json.load(fh)
            except (OSError, json.JSONDecodeError):
                stack = []
            stack.extend(disappeared)
            if len(stack) > MAX_CLOSED_PANES:
                stack = stack[-MAX_CLOSED_PANES:]
            tmp = CLOSED_PANES_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(stack, fh)
            os.replace(tmp, CLOSED_PANES_FILE)
    except Exception:
        pass


def restore_last_closed_pane():
    """Pop the last closed pane from the stack and reopen it."""
    try:
        with open(CLOSED_PANES_LOCK, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                with open(CLOSED_PANES_FILE, "r", encoding="utf-8") as fh:
                    stack = json.load(fh)
            except (OSError, json.JSONDecodeError):
                stack = []
            if not stack:
                return
            entry = stack.pop()
            tmp = CLOSED_PANES_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(stack, fh)
            os.replace(tmp, CLOSED_PANES_FILE)
    except Exception:
        return

    cwd = entry.get("cwd") or os.path.expanduser("~")
    agent = entry.get("agent")
    session_file = entry.get("session_file")
    session_name = entry.get("session_name") or ""

    client = live_tmux_client(os.environ.get("PI_SIDEBAR_CLIENT", ""))
    try:
        r = subprocess.run(
            tmux_command("display-message", "-p", "#{session_name}"),
            capture_output=True, text=True, timeout=0.5, check=False,
        )
        current_session = r.stdout.strip()
    except Exception:
        current_session = ""
    if not current_session or current_session.startswith("_"):
        return

    win_name = (session_name[:20] if session_name
                else os.path.basename(os.path.normpath(cwd)) or "shell")
    try:
        r = subprocess.run(
            tmux_command(
                "new-window", "-d", "-P",
                "-F", "#{session_name}:#{window_index}\t#{pane_id}",
                "-t", f"{current_session}:",
                "-c", cwd, "-n", win_name,
            ),
            capture_output=True, text=True, timeout=2, check=False,
        )
        target, sep, pane_id = r.stdout.strip().partition("\t")
        if not sep or not pane_id:
            return
    except Exception:
        return

    if agent in ("omp", "pi"):
        if agent == "omp":
            resume_arg = f"--resume {shlex.quote(session_file)}" if session_file else "--continue"
            cmd = f"omp {resume_arg}"
        else:
            resume_arg = f"--resume {shlex.quote(session_file)}" if session_file else "--continue"
            cmd = f"pi {resume_arg}"

        def _send():
            try:
                subprocess.run(
                    tmux_command("send-keys", "-t", pane_id, "-l", cmd + "\r"),
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=1, check=False,
                )
            except Exception:
                pass
        threading.Timer(0.5, _send).start()

    if client:
        subprocess.run(
            tmux_command("switch-client", "-c", client, "-t", current_session),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=1, check=False,
        )
    subprocess.run(
        tmux_command("select-window", "-t", target),
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=1, check=False,
    )


def collapse_button_hit(x, y, width):
    if MODE == "collapsed":
        # Button row only (plus the blank top margin above it). The row below
        # the button is the gap before session 1, so leave it inert.
        return y <= 1
    if y != _collapse_button_row:
        return False
    end = width - RIGHT_MARGIN
    start = max(1, end - len(COLLAPSE_BUTTON) + 1)
    return start - BUTTON_HIT_SLACK <= x <= end + BUTTON_HIT_SLACK


def handle_input(data, width):
    text = data.decode("utf-8", errors="ignore")
    # SGR mouse press from terminals/tmux: ESC [ < button ; x ; y M
    for match in re.finditer(r"\x1b\[<([0-9]+);([0-9]+);([0-9]+)([Mm])", text):
        button = int(match.group(1))
        x = int(match.group(2))
        y = int(match.group(3)) - TOP_MARGIN  # adjust for top margin offset
        final = match.group(4)
        if final == "M" and button == 0 and collapse_button_hit(x, y, width):
            sidebar_action()
            return
        if final == "M" and button == 0:
            session_target = SESSION_BUTTON_TARGETS.get(y)
            if session_target is not None:
                session, cwd, start, end = session_target
                if start <= x <= end:
                    create_session_window(session, cwd)
                    return
        if final == "M" and button == 0:
            target_pane = CLICK_TARGETS.get(y)
            if target_pane is not None:
                jump_to_pane(target_pane)
                return
    if MODE == "collapsed" and text in {"\r", "\n", " ", "o", "O", "\x1b"}:
        sidebar_action()
    elif MODE == "expanded" and text in {"q", "Q", "x", "X", "\x1b"}:
        sidebar_action()


def poll_input(width):
    try:
        fd = sys.stdin.fileno()
        ready, _, _ = select.select([fd], [], [], 0)
        if not ready:
            return
        data = os.read(fd, 4096)
        if data:
            handle_input(data, width)
    except Exception:
        pass


TAB_SIGNAL_LOCK = "/tmp/pi-sidebar-tab-signal.lock"
_tab_signal_lock_fh = None

def acquire_tab_signal_lock():
    """Try to acquire a persistent lock for tab title animation.
    Only one sidebar process holds this for its entire lifetime."""
    global _tab_signal_lock_fh
    try:
        _tab_signal_lock_fh = open(TAB_SIGNAL_LOCK, "w")
        fcntl.flock(_tab_signal_lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except (IOError, OSError):
        if _tab_signal_lock_fh:
            _tab_signal_lock_fh.close()
            _tab_signal_lock_fh = None
        return False

def update_tab_title_signals(panes):
    """Update @pi_window_signal for each window with a working Pi pane.
    Only runs if this process holds the persistent tab signal lock."""
    if _tab_signal_lock_fh is None:
        return
    frame = ANIM_FRAMES[anim_frame % len(ANIM_FRAMES)]
    signal = f"#[fg=#f59e0b]{frame}#[default]"
    seen_windows = set()
    for pane in panes:
        if pane.display_status != "working":
            continue
        win = f"{pane.session}:{pane.window_index}"
        if win in seen_windows:
            continue
        seen_windows.add(win)
        try:
            subprocess.run(
                tmux_command("set-option", "-wq", "-t", win, "@pi_window_signal", signal),
                timeout=0.2, check=False,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass

def refresh_pane_state():
    global _pane_state
    try:
        _pane_state = fetch_pane_state()
    except Exception:
        pass
    finally:
        _fetch_ready.set()


def start_pane_refresh():
    global _fetch_thread
    if _fetch_thread is not None and _fetch_thread.is_alive():
        return
    _fetch_ready.clear()
    _fetch_thread = threading.Thread(target=refresh_pane_state, daemon=True)
    _fetch_thread.start()


def run_tab_signal_animator():
    next_frame = time.monotonic()
    while running:
        if not _animations_paused:
            state = _pane_state
            if state:
                update_tab_title_signals(state[0])
        next_frame += ANIM_INTERVAL
        delay = next_frame - time.monotonic()
        if delay <= 0:
            next_frame = time.monotonic()
            continue
        time.sleep(delay)



def main():
    global needs_redraw, anim_frame
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGWINCH, on_winch)
    signal.signal(signal.SIGUSR1, on_selection_refresh)
    signal.signal(signal.SIGUSR2, on_animation_focus)
    is_tab_animator = acquire_tab_signal_lock()
    stdin_fd = None
    old_term = None
    try:
        if sys.stdin.isatty():
            stdin_fd = sys.stdin.fileno()
            old_term = termios.tcgetattr(stdin_fd)
            tty.setcbreak(stdin_fd)
        sys.stdout.write(ENABLE_MOUSE)
        sys.stdout.flush()
        redraw(use_cache=False)
        register_sidebar_pid()
        if is_tab_animator:
            threading.Thread(target=run_tab_signal_animator, daemon=True).start()
        next_frame = time.monotonic() + ANIM_INTERVAL
        next_fetch = time.monotonic() + FETCH_INTERVAL
        while running:
            if os.getppid() == 1:
                break

            if _selection_refresh_requested.is_set():
                _selection_refresh_requested.clear()
                refresh_selected_pane()
                if not _animations_paused:
                    redraw(use_cache=True)

            now = time.monotonic()
            if now >= next_fetch:
                start_pane_refresh()
                next_fetch += FETCH_INTERVAL
                if next_fetch <= now:
                    next_fetch = now + FETCH_INTERVAL

            if _fetch_ready.is_set():
                _fetch_ready.clear()
                if not _animations_paused:
                    redraw(use_cache=True)
            elif needs_redraw and not _animations_paused:
                redraw(use_cache=True)

            now = time.monotonic()
            if now >= next_frame:
                frame_count = 1 + int((now - next_frame) / ANIM_INTERVAL)
                advance_animation(frame_count)
                next_frame += frame_count * ANIM_INTERVAL
                if not _animations_paused:
                    redraw(use_cache=True)

            min_width = 3 if MODE == "collapsed" else 10
            try:
                width = max(min_width, os.get_terminal_size(sys.stdout.fileno()).columns)
            except Exception:
                width = min_width
            poll_input(width)

            next_deadline = min(next_frame, next_fetch)
            timeout = max(0.0, next_deadline - time.monotonic())
            _wake_event.wait(timeout)
            _wake_event.clear()
    finally:
        unregister_sidebar_pid()
        try:
            sys.stdout.write(DISABLE_MOUSE + RESET + SHOW_CURSOR + "\033[2J\033[H")
            sys.stdout.flush()
        except Exception:
            pass
        if stdin_fd is not None and old_term is not None:
            try:
                termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_term)
            except Exception:
                pass


if __name__ == "__main__":
    if PLAY_SOUND:
        import shutil
        play_status_sound_worker()
    elif JUMP_NUMBER is not None:
        jump_to_number(JUMP_NUMBER)
    elif RESTORE_LAST:
        restore_last_closed_pane()
    else:
        main()
