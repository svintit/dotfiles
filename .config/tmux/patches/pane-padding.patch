+/* Return the configured pane-padding option, clamped to its allowed range. */
+int
+window_pane_padding(struct window_pane *wp)
+{
+	int	pad;
+
+	pad = options_get_number(wp->options, "pane-padding");
+	if (pad < 0)
+		pad = 0;
+	if (pad > 20)
+		pad = 20;
+	return (pad);
