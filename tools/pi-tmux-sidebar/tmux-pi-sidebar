def tmux_list_panes():
    fmt = "\x1f".join([
        "#{session_name}",
        "#{window_index}",
        "#{window_name}",
        "#{pane_index}",
        "#{pane_id}",
        "#{pane_pid}",
        "#{pane_title}",
        "#{pane_current_command}",
        "#{pane_current_path}",
        "#{@pi_session_name}",
        "#{@pi_agent_status}",
        "#{@pi_pr_joust_active_until}",
        "#{@pi_slack_thread_user}",
        "#{@pi_sidebar_unread}",
        "#{@pi_sidebar_kind}",
        "#{pane_active}",
        "#{window_active}",
        "#{session_attached}",
        "#{session_last_attached}",
        "#{@pi_freeze_state}",
        "#{@pi_freeze_resume_id}",
        "#{@pi_freeze_cwd}",
        "#{@pi_freeze_last_activity}",
        "#{@pi_freeze_summary}",
        "#{@pi_frozen_at}",
        "#{@pi_freeze_prompt_active}",
        "#{@pi_freeze_resume_started}",
    ]) + "\x1e"
    try:
        result = subprocess.run(
            tmux_command("list-panes", "-a", "-F", fmt),
            capture_output=True,
            text=True,
            timeout=0.8,
            check=False,
        )
    except Exception:
        return []
    if result.returncode != 0:
        return []
    panes = []
    for record in result.stdout.split("\x1e\n"):
        if not record:
            continue
        parts = record.split("\x1f")
        if len(parts) != 27:
            continue
        pane = Pane(parts)
        if pane.is_sidebar:
            continue
        if pane.session.startswith(("_", "pi-status-test")):
            continue
        if pane.has_pi_metadata or pane.is_pi_pane or pane.command == "pi":
            panes.append(pane)
    return panes

def real_pane_for_window(window_id):
    try:
        result = subprocess.run(
            tmux_command(
                "list-panes",
                "-t",
                window_id,
                "-F",
                "#{pane_id}\t#{@pi_sidebar_kind}\t#{pane_active}",
            ),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
        candidates = []
        for line in result.stdout.splitlines():
            pane_id, kind, active = line.split("\t")
            if kind != SIDEBAR_KIND:
                candidates.append((active == "1", pane_id))
        return max(candidates, default=(False, None))[1]
    except Exception:
        return None


def fetch_selected_pane_id():
    if TARGET_CLIENT:
        try:
            clients = subprocess.run(
                tmux_command("list-clients", "-F", "#{client_name}\t#{session_name}"),
                capture_output=True,
                text=True,
                timeout=0.5,
                check=False,
            )
            target_session = None
            for line in clients.stdout.splitlines():
                client_name, _, session_name = line.partition("\t")
                if client_name == TARGET_CLIENT:
                    target_session = session_name
                    break
            if target_session:
                result = subprocess.run(
                    tmux_command(
                        "display-message",
                        "-p",
                        "-t",
                        target_session,
                        "#{pane_id}\t#{@pi_sidebar_kind}\t#{window_id}",
                    ),
                    capture_output=True,
                    text=True,
                    timeout=0.5,
                    check=False,
                )
                pane_id, kind, window_id = result.stdout.strip().split("\t")
                if kind == SIDEBAR_KIND:
                    pane_id = real_pane_for_window(window_id)
                if pane_id and pane_id.startswith("%"):
                    return pane_id
        except Exception:
            pass
    fmt = "\t".join([
        "#{pane_id}",
        "#{pane_active}",
        "#{window_active}",
        "#{session_attached}",
        "#{session_last_attached}",
    ])
    try:
        result = subprocess.run(
            tmux_command("list-panes", "-a", "-F", fmt),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
    except Exception:
        return None
    candidates = []
    for line in result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 5:
            continue
        pane_id, pane_active, window_active, session_attached, last_attached = parts
        if pane_active != "1" or window_active != "1" or session_attached in {"", "0"}:
            continue
        try:
            candidates.append((int(last_attached or 0), pane_id))
        except ValueError:
            candidates.append((0, pane_id))
    return max(candidates, default=(0, None))[1]


def load_selected_hint():
    try:
        with open(SELECTION_HINT_FILE, "r", encoding="utf-8") as fh:
            pane_id = fh.read().strip()
        return pane_id if pane_id.startswith("%") else None
    except Exception:
        return None


def publish_selected_hint(pane_id):
    try:
        tmp = f"{SELECTION_HINT_FILE}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(pane_id + "\n")
        os.replace(tmp, SELECTION_HINT_FILE)
    except Exception:
        pass


def refresh_selected_pane():
    global _pane_state
    if _pane_state is None:
        return
    panes, color_map, grouped, _selected_pane_id, unread = _pane_state
    selected_pane_id = load_selected_hint()
    if selected_pane_id not in {pane.pane_id for pane in panes}:
        selected_pane_id = fetch_selected_pane_id()
    if selected_pane_id is not None:
        _pane_state = panes, color_map, grouped, selected_pane_id, unread


def register_sidebar_pid():
    try:
        if EXTERNAL_SIDEBAR:
            subprocess.run(
                tmux_command("set-option", "-gq", "@pi_sidebar_external_pid", str(os.getpid())),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=0.5,
                check=False,
            )
            return
        pane_id = os.environ.get("TMUX_PANE", "")
        if not pane_id:
            return
        subprocess.run(
            tmux_command("set-option", "-pq", "-t", pane_id, "@pi_sidebar_pid", str(os.getpid())),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.5,
            check=False,
        )
        subprocess.run(
            tmux_command("set-option", "-wq", "-t", pane_id, "@pi_sidebar_pid", str(os.getpid())),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.5,
            check=False,
        )
    except Exception:
        pass

def unregister_sidebar_pid():
    if not EXTERNAL_SIDEBAR:
        return
    try:
        result = subprocess.run(
            tmux_command("show-option", "-gqv", "@pi_sidebar_external_pid"),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
        if result.stdout.strip() == str(os.getpid()):
            subprocess.run(
                tmux_command("set-option", "-gu", "@pi_sidebar_external_pid"),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=0.5,
                check=False,
            )
    except Exception:
        pass


def clean_token(value, limit):
    value = (value or "").strip().lstrip("@")
    keep = []
    for ch in value:
        if ch.isalnum() or ch in "._-":
            keep.append(ch)
        elif ch.isspace():
            keep.append("-")
    return truncate("".join(keep).strip("-"), limit)


def limit_words(text, max_words):
    words = text.split()
    if len(words) <= max_words:
        return text
    return " ".join(words[:max_words]) + "…"
GENERIC_NAMES = {"src", "main", "root", "master", "trunk", "default", "pi", "omp", "dev", "world"}
HOME_BASENAME = os.path.basename(os.path.normpath(os.path.expanduser("~")))

def clean_label(value):
    value = (value or "").strip()
    if " // " in value:
        value = value.split(" // ", 1)[1].strip()
    if value.startswith("π - "):
        parts = value.split(" - ")
        if len(parts) >= 3:
            value = " - ".join(parts[1:-1]).strip()
        else:
            # 2-part "π - <dir>" means pi had no session name, so the title
            # collapsed to the dir basename (e.g. "src").
            if len(parts) > 1 and parts[1].strip() == HOME_BASENAME:
                return "~"
            return "-"
    elif value.startswith("π: "):
        value = value[3:].strip()
    elif value.startswith("π > "):
        # omp format "π > <name>"; strip the prefix.
        value = value[4:].strip()
    # Reject generic names that are just directory names or defaults
    # (e.g. omp title "π: src" when no session name has been set yet).
    # omp/pi fall back to the cwd basename; show home as "~", not the username.
    if value == HOME_BASENAME:
        return "~"
    if value.lower() in GENERIC_NAMES:
        return "-"
    return value.strip()


def truncate(value, width):
    if width <= 0:
        return ""
    if len(value) <= width:
        return value
    if width == 1:
        return "…"
    return value[: width - 1].rstrip("- ") + "…"


def visible_len(value):
    plain = re.sub(r"\033\[[0-9;?]*[A-Za-z]", "", value)
    return len(plain.replace("\ufe0e", "").replace("\ufe0f", ""))

def fit(line, width):
    raw = line
    if visible_len(raw) <= width:
        return raw
    # Keep this simple because ANSI color segments make exact truncation fussy.
    plain = re.sub(r"\033\[[0-9;?]*[A-Za-z]", "", raw)
    return truncate(plain, width)

def pad_visible(text, width):
    """Pad text with spaces to reach the given visible width."""
    return text + " " * max(0, width - visible_len(text))

ART_TRACE_BRIGHT = "\033[38;2;245;230;255m"
ART_TRACE_TAIL = "\033[38;2;220;190;250m"
# Dark and light endpoints for the subtle base color oscillation.
ART_BASE_DARK = (130, 50, 210)
ART_BASE_LIGHT = (220, 70, 170)
_art_color_phase = 0

def advance_animation(frame_count=1):
    global anim_frame, _art_phase, _art_color_phase
    anim_frame = (anim_frame + frame_count) % len(ANIM_FRAMES)
    _art_phase = (_art_phase + 1.5 * frame_count) % ART_TRACE_LEN
    _art_color_phase = (_art_color_phase + frame_count) % 400

def _art_base_color():
    t = _art_color_phase / 400.0
    wave = (math.sin(t * 2 * math.pi) + 1) / 2
    r = int(ART_BASE_DARK[0] + wave * (ART_BASE_LIGHT[0] - ART_BASE_DARK[0]))
    g = int(ART_BASE_DARK[1] + wave * (ART_BASE_LIGHT[1] - ART_BASE_DARK[1]))
    b = int(ART_BASE_DARK[2] + wave * (ART_BASE_LIGHT[2] - ART_BASE_DARK[2]))
    return f"\033[38;2;{r};{g};{b}m"

def tracer_art_lines(pad):
    """ASCII art with a bright tracer dot traveling along the character
    outlines, leaving a short comet tail behind."""
    head = int(_art_phase)
    trace = {}
    for offset in range(7):
        idx = (head - offset) % ART_TRACE_LEN
        li, ci = ART_TRACE_CELLS[idx]
        if ASCII_ART[li][ci] in SHADOW_CHARS:
            trace[(li, ci)] = ART_TRACE_BRIGHT if offset <= 1 else ART_TRACE_TAIL
    base = _art_base_color()
    result = []
    for li, line in enumerate(ASCII_ART):
        line_trace = {ci: col for (l, ci), col in trace.items() if l == li}
        if not line_trace:
            result.append(f"{base}{pad}{line}{RESET}")
            continue
        parts = [pad, base]
        prev = base
        for ci, ch in enumerate(line):
            col = line_trace.get(ci, base)
            if col != prev:
                parts.append(col)
                prev = col
            parts.append(ch)
        parts.append(RESET)
        result.append("".join(parts))
    return result


def header_lines(width):
    """Return list of header line strings (ASCII art banner or plain fallback)."""
    global _collapse_button_row
    if width >= ASCII_ART_WIDTH:
        # Collapse button on the first line, right-aligned.
        btn_gap = max(0, width - len(COLLAPSE_BUTTON))
        result = [f"{' ' * btn_gap}{RED}{COLLAPSE_BUTTON}{RESET}", ""]
        _collapse_button_row = 1
        offset = (width - ASCII_ART_WIDTH) // 2
        pad = " " * offset
        result.extend(tracer_art_lines(pad))
        return result
    # Fallback: plain text title with button on a single line.
    title = "PI SESH"
    if width < len(title) + len(COLLAPSE_BUTTON) + 1:
        _collapse_button_row = 1
        return [f"{HEADER}{truncate(title, width)}{RESET}"]
    gap = max(1, width - len(title) - len(COLLAPSE_BUTTON))
    _collapse_button_row = 1
    return [f"{HEADER}{title}{RESET}{' ' * gap}{RED}{COLLAPSE_BUTTON}{RESET}"]


