def stabilize_completed_status(panes):
    """Delay completed transitions and prefer OMP's native busy title."""
    now = time.monotonic()
    live_ids = {pane.pane_id for pane in panes}
    completed_values = {"done", "completed", "complete"}


    for pane in panes:
        pane.suppress_completed = False
        pane_id = pane.pane_id
        raw_status = (pane.pi_status or "").strip().lower()
        previous = _last_raw_status.get(pane_id)


        if pane.native_title_busy:
            if raw_status in completed_values:
                _completion_pending_since.setdefault(pane_id, now)
            else:
                _completion_pending_since.pop(pane_id, None)
        elif raw_status in completed_values and previous is not None and previous not in completed_values:
            _completion_pending_since[pane_id] = now
            pane.suppress_completed = True
        elif raw_status in completed_values and pane_id in _completion_pending_since:
            elapsed = now - _completion_pending_since[pane_id]
            if elapsed < COMPLETED_STABILITY_SECONDS:
                pane.suppress_completed = True
            else:
                _completion_pending_since.pop(pane_id, None)
        elif raw_status not in completed_values:
            _completion_pending_since.pop(pane_id, None)


        _last_raw_status[pane_id] = raw_status

    for pane_id in set(_last_raw_status) - live_ids:
        _last_raw_status.pop(pane_id, None)
        _completion_pending_since.pop(pane_id, None)


def live_omp_pane_ids(panes):
    roots = {}
    for pane in panes:
        try:
            roots[int(pane.pane_pid)] = pane.pane_id
        except (TypeError, ValueError):
            continue
    if not roots:
        return set()
    try:
        result = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,command="],
            capture_output=True,
            text=True,
            timeout=1,
            check=False,
        )
    except Exception:
        return None
    if result.returncode != 0:
        return None
    parents = {}
    omp_pids = []
    for line in result.stdout.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) != 3:
            continue
        try:
            pid = int(parts[0])
            parents[pid] = int(parts[1])
        except ValueError:
            continue
        if "omp --bun" in parts[2]:
            omp_pids.append(pid)
    live = set()
    for pid in omp_pids:
        seen = set()
        while pid > 1 and pid not in seen:
            seen.add(pid)
            pane_id = roots.get(pid)
            if pane_id:
                live.add(pane_id)
                break
            pid = parents.get(pid, 0)
    return live


def reconcile_frozen_state(panes):
    live_ids = live_omp_pane_ids(panes)
    if live_ids is None:
        return False
    for pane in panes:
        pane.live_omp = pane.pane_id in live_ids
    return True

