def update_unread_state(panes, selected_pane_id, numbers=None):
    """Track automatic status changes and explicit unread markers."""
    try:
        lock_fh = open(STATE_LOCK, "w", encoding="utf-8")
        fcntl.flock(lock_fh, fcntl.LOCK_EX)
    except Exception:
        return {}
    try:
        unread, last_status, prev_numbers, manual_seen = load_state_locked()
        prev_unread = dict(unread)
        prev_last_status = dict(last_status)
        prev_manual_seen = {
            pid: dict(entry) if isinstance(entry, dict) else entry
            for pid, entry in manual_seen.items()
        }
        numbers = prev_numbers if numbers is None else numbers
        markers_to_clear = []
        current_ids = {p.pane_id for p in panes}
        for pid in list(last_status.keys()):
            if pid not in current_ids:
                last_status.pop(pid, None)
                unread.pop(pid, None)
        for pid in list(manual_seen.keys()):
            if pid not in current_ids:
                manual_seen.pop(pid, None)
        for pane in panes:
            pid = pane.pane_id
            cur = pane.display_status
            prev = last_status.get(pid)
            if prev is not None and prev != cur:
                is_clock_transition = prev == "clock" or cur == "clock"
                is_freeze_transition = cur == "frozen"
                is_unread = (pid != selected_pane_id) and not is_clock_transition and not is_freeze_transition
                unread[pid] = is_unread
                if is_unread and cur != "working" and cur and not is_clock_transition and not is_freeze_transition:
                    now = time.monotonic()
                    last_sound_time = last_sound_time_map.get(pid, 0)
                    if now - last_sound_time >= 5.0:
                        play_status_sound()
                        last_sound_time_map[pid] = now
            if pid == selected_pane_id:
                unread[pid] = False
            if cur == "asking" and pid != selected_pane_id:
                unread[pid] = True
            if cur == "working":
                unread[pid] = False
            if cur == "frozen":
                unread[pid] = False
            if cur:
                last_status[pid] = cur

            manual_token = (pane.manual_unread or "").strip()
            if not manual_token:
                manual_seen.pop(pid, None)
                continue
            entry = manual_seen.get(pid)
            if not isinstance(entry, dict) or entry.get("token") != manual_token:
                manual_seen[pid] = {
                    "token": manual_token,
                    "left": pid != selected_pane_id,
                }
                unread[pid] = True
            elif pid == selected_pane_id and entry.get("left"):
                unread[pid] = False
                manual_seen.pop(pid, None)
                markers_to_clear.append(pid)
            else:
                if pid != selected_pane_id:
                    entry["left"] = True
                unread[pid] = True

        if unread != prev_unread or last_status != prev_last_status or numbers != prev_numbers or manual_seen != prev_manual_seen:
            save_state_locked(unread, last_status, numbers, manual_seen)
        for pid in markers_to_clear:
            clear_manual_unread_marker(pid)
        return unread
    finally:
        try:
            fcntl.flock(lock_fh, fcntl.LOCK_UN)
            lock_fh.close()
        except Exception:
            pass


