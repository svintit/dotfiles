#!/usr/bin/env bash
# Resume Pi and OMP sessions after tmux-resurrect restores the pane layout.
set -euo pipefail

RESURRECT_DIR="${TMUX_RESURRECT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect}"
PI_SESSION_ROOT="${TMUX_PI_SESSION_ROOT:-$HOME/.pi/agent/sessions}"
OMP_SESSION_ROOT="${TMUX_OMP_SESSION_ROOT:-$HOME/.omp/agent/sessions}"
SOCK="${TMUX_SOCK:-ghostty-main}"
LOG="${TMPDIR:-/tmp}/tmux-resurrect-restore-agents.log"
FREEZE_REGISTRY="${TMUX_FREEZE_REGISTRY:-$HOME/.local/bin/pi-session-freeze-registry}"

last_link="$RESURRECT_DIR/last"
last_target=$(readlink "$last_link" 2>/dev/null || true)
[ -n "$last_target" ] || exit 0
if [[ "$last_target" = /* ]]; then
  last_file="$last_target"
else
  last_file="$RESURRECT_DIR/$last_target"
fi
[ -f "$last_file" ] || exit 0

: > "$LOG"

find_session_id() {
  local kind=$1
  local label=$2
  python3 - "$kind" "$label" "$PI_SESSION_ROOT" "$OMP_SESSION_ROOT" <<'PY'
import glob
import json
import os
import sys

kind, label, pi_root, omp_root = sys.argv[1:]
search = " ".join(label.lower().split())
root = omp_root if kind == "omp" else pi_root
exact = []
fuzzy = []

for path in glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True):
    session_id = ""
    names = []
    try:
        with open(path, errors="replace") as handle:
            for line in handle:
                try:
                    data = json.loads(line)
                except Exception:
                    continue
                record_type = data.get("type")
                if kind == "omp":
                    if record_type == "session":
                        session_id = data.get("id", "")
                        names.append(data.get("title", ""))
                    elif record_type in {"title", "title_change"}:
                        names.append(data.get("title", ""))
                else:
                    if record_type == "session_info":
                        names.append(data.get("name", ""))
                    elif record_type == "custom" and data.get("customType") == "conversation-title":
                        names.append(data.get("data", {}).get("name", ""))
        if kind == "omp" and not session_id:
            continue
        if kind == "pi" and not session_id:
            base = os.path.basename(path).removesuffix(".jsonl")
            session_id = base.split("_", 1)[-1]
    except OSError:
        continue

    normalized = {" ".join(str(name).lower().split()) for name in names if name}
    mtime = os.path.getmtime(path)
    if search in normalized:
        exact.append((mtime, session_id))
    elif len(search) >= 12 and any(
        name.startswith(search) or search.startswith(name)
        for name in normalized
        if len(name) >= 12
    ):
        fuzzy.append((mtime, session_id))

matches = exact or fuzzy
if matches:
    print(max(matches)[1])
PY
}

restore_agent() {
  local target=$1
  local command=$2
  if [ "${TMUX_RESTORE_DRY_RUN:-0}" = "1" ]; then
    printf '%s -> %s\n' "$target" "$command"
    return
  fi
  (
    sleep 2
    if tmux -L "$SOCK" display-message -p -t "$target" '#{pane_id}' >/dev/null 2>&1; then
      tmux -L "$SOCK" send-keys -t "$target" -l "$command"$'\r'
      printf '%s -> %s\n' "$target" "$command" >> "$LOG"
    fi
  ) &
}

extract_agent_label() {
  local title=$1
  local label=""

  case "$title" in
    "π: "*) label="${title#π: }" ;;
    "π > "*) label="${title#π > }" ;;
    "π - "*)
      label="${title#π - }"
      [[ "$label" == *" - "* ]] && label="${label% - *}"
      ;;
    "π "*)
      label="${title#π }"
      case "$label" in
        "⠋ "*|"⠙ "*|"⠹ "*|"⠸ "*|"⠼ "*|"⠴ "*|"⠦ "*|"⠧ "*|"⠇ "*|"⠏ "*|"⠖ "*|"⠲ "*|"⢲ "*|"⢰ "*|"⣰ "*|"⣠ "*|"⣄ "*|"⣆ "*|"⡆ "*|"⡖ "*)
          label="${label#? }"
          ;;
      esac
      ;;
  esac

  [ -n "$label" ] || return 1
  [ "$label" != "src" ] || return 1
  [ "$label" != "-" ] || return 1
  printf '%s\n' "$label"
}

restore_frozen_session() {
  local target=$1
  local session_id=$2
  local record metadata frozen_cwd frozen_at
  [ -x "$FREEZE_REGISTRY" ] || return 1
  record=$("$FREEZE_REGISTRY" get "$session_id" 2>/dev/null) || return 1
  metadata=$(python3 - "$record" <<'PY'
import json
import sys
record = json.loads(sys.argv[1])
print(f"{record.get('cwd', '')}\t{record.get('frozenAt', '')}")
PY
)
  IFS=$'\t' read -r frozen_cwd frozen_at <<< "$metadata"
  if [ "${TMUX_RESTORE_DRY_RUN:-0}" = "1" ]; then
    printf '%s -> frozen omp %s\n' "$target" "$session_id"
    return 0
  fi
  tmux -L "$SOCK" set-option -p -t "$target" @pi_freeze_state frozen
  tmux -L "$SOCK" set-option -p -t "$target" @pi_freeze_resume_id "$session_id"
  tmux -L "$SOCK" set-option -p -t "$target" @pi_agent_status frozen
  [ -n "$frozen_cwd" ] && tmux -L "$SOCK" set-option -p -t "$target" @pi_freeze_cwd "$frozen_cwd"
  if [ -n "$frozen_at" ]; then
    tmux -L "$SOCK" set-option -p -t "$target" @pi_frozen_at "$frozen_at"
    tmux -L "$SOCK" set-option -p -t "$target" @pi_freeze_last_activity "$frozen_at"
  fi
  (
    sleep 2
    if tmux -L "$SOCK" display-message -p -t "$target" '#{pane_id}' >/dev/null 2>&1; then
      tmux -L "$SOCK" send-keys -t "$target" -l "source ~/.config/fish/functions/__omp_resume_once.fish; source ~/.config/fish/functions/__pi_freeze_prompt.fish; __pi_freeze_prompt"$'\r'
    fi
  ) &
  printf '%s -> frozen omp %s (resume prompt shown)\n' "$target" "$session_id" >> "$LOG"
}


restore_agent_by_label() {
  local target=$1
  local label=$2
  local session_id=""

  # OMP is the normal launcher in these panes. Try Pi as a fallback.
  session_id=$(find_session_id omp "$label" || true)
  if [ -n "$session_id" ]; then
    if restore_frozen_session "$target" "$session_id"; then
      return
    fi
    restore_agent "$target" "omp --resume $session_id; source ~/.config/fish/functions/__omp_resume_once.fish; source ~/.config/fish/functions/__pi_freeze_prompt.fish; __pi_freeze_prompt"
    return
  fi

  session_id=$(find_session_id pi "$label" || true)
  if [ -n "$session_id" ]; then
    restore_agent "$target" "pi --session $session_id"
    return
  fi

  printf '%s -> no agent session match for %s\n' "$target" "$label" >> "$LOG"
}

declare -A restore_window_names=()
while IFS=$'\t' read -r record session window window_name _rest; do
  [ "$record" = "window" ] || continue
  restore_window_names["$session:$window"]="${window_name#:}"
done < "$last_file"

while IFS=$'\t' read -r record session window _window_active _flags pane title cwd _pane_active pane_command full_command; do
  [ "$record" = "pane" ] || continue
  [[ "$session" == _popup_window_* ]] && continue

  title="${title#:}"
  cwd="${cwd#:}"
  full_command="${full_command#:}"
  [ "$title" = "__gap__" ] && continue
  target="${session}:${window}.${pane}"
  if [ -x "$FREEZE_REGISTRY" ]; then
    frozen_session_id=$("$FREEZE_REGISTRY" find-title "$title" 2>/dev/null || true)
    if [ -n "$frozen_session_id" ] && restore_frozen_session "$target" "$frozen_session_id"; then
      continue
    fi
  fi

  # tmux-resurrect saves fish-pad, not the nested Pi or OMP process.
  # The native π title remains available, so use it as the agent marker.
  if [[ "$title" == π* ]]; then
    label=$(extract_agent_label "$title" || true)
    if [ -z "$label" ]; then
      window_label="${restore_window_names["$session:$window"]:-}"
      [[ -n "$window_label" && "$window_label" != π* ]] && label="$window_label"
    fi
    if [ -n "$label" ]; then
      restore_agent_by_label "$target" "$label"
    else
      printf '%s -> no usable agent label in %s\n' "$target" "$title" >> "$LOG"
    fi
  fi
done < "$last_file"

wait
[ "${TMUX_RESTORE_DRY_RUN:-0}" = "1" ] && exit 0
[ "${TMUX_RESTORE_SKIP_SIDEBAR:-0}" = "1" ] && exit 0
sleep 1
tmux -L "$SOCK" set-option -g @pi_sidebar_enabled 1
tmux -L "$SOCK" set-option -g @pi_sidebar_state expanded
# Remove stray sidebar shells that tmux-resurrect restored as plain panes.
# It restores the __gap__ title but not @pi_sidebar_kind and does not rerun the
# TUI, so the old sidebar panes come back as bare shells. Left in place they
# cause a doubled split once ensure-all adds fresh sidebars. Kill them first.
for _p in $(tmux -L "$SOCK" list-panes -a -F '#{pane_id}|#{@pi_sidebar_kind}|#{pane_title}' | awk -F'|' '$3=="__gap__" && $2!="pi-sidebar"{print $1}'); do
  tmux -L "$SOCK" kill-pane -t "$_p" 2>/dev/null || true
done
TMUX="$(tmux -L "$SOCK" display-message -p '#{socket_path}'),0,0" \
  "$HOME/.local/bin/tmux-pi-sidebar-toggle" ensure-all >> "$LOG" 2>&1 || true
