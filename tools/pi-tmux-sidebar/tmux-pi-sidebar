def cksum_value(text):
    try:
        result = subprocess.run(
            ["cksum"],
            input=text,
            capture_output=True,
            text=True,
            timeout=0.3,
            check=False,
        )
        if result.returncode == 0:
            return int(result.stdout.split()[0])
    except Exception:
        pass
    # Fallback only if cksum is unavailable.
    value = 0
    for ch in text:
        value = (value * 33 + ord(ch)) & 0xFFFFFFFF
    return value


def xterm_colour_to_rgb(code):
    if 16 <= code <= 231:
        offset = code - 16
        r_component = offset // 36
        g_component = (offset // 6) % 6
        b_component = offset % 6
        r = 0 if r_component == 0 else 55 + r_component * 40
        g = 0 if g_component == 0 else 55 + g_component * 40
        b = 0 if b_component == 0 else 55 + b_component * 40
        return r, g, b
    if 232 <= code <= 255:
        value = 8 + (code - 232) * 10
        return value, value, value
    return 255, 255, 255

def tinted_bg(session_colour_code):
    """Blend the session's xterm colour with the dark base to tint the selected-row background."""
    base_r, base_g, base_b = 26, 36, 48
    if session_colour_code is None:
        return BG_SELECTED
    r, g, b = xterm_colour_to_rgb(session_colour_code)
    alpha = 0.15
    tr = int(base_r * (1 - alpha) + r * alpha)
    tg = int(base_g * (1 - alpha) + g * alpha)
    tb = int(base_b * (1 - alpha) + b * alpha)
    return f"\033[48;2;{tr};{tg};{tb}m"


def colours_too_similar(candidate, used):
    cr, cg, cb = xterm_colour_to_rgb(candidate)
    ur, ug, ub = xterm_colour_to_rgb(used)
    distance = (cr - ur) ** 2 + (cg - ug) ** 2 + (cb - ub) ** 2
    return distance < MIN_COLOUR_DISTANCE_SQUARED


def colour_is_distinct(candidate, used_codes):
    if candidate in used_codes:
        return False
    return not any(colours_too_similar(candidate, used) for used in used_codes)


def pick_sesh_colour(hash_value, used_codes):
    palette_size = len(SESH_PALETTE)
    start = hash_value % palette_size
    for offset in range(palette_size):
        candidate = SESH_PALETTE[(start + offset) % palette_size]
        if colour_is_distinct(candidate, used_codes):
            used_codes.append(candidate)
            return candidate
    for offset in range(palette_size):
        candidate = SESH_PALETTE[(start + offset) % palette_size]
        if candidate not in used_codes:
            used_codes.append(candidate)
            return candidate
    for candidate in range(16, 232):
        if colour_is_distinct(candidate, used_codes):
            used_codes.append(candidate)
            return candidate
    for candidate in range(16, 232):
        if candidate not in used_codes:
            used_codes.append(candidate)
            return candidate
    return SESH_PALETTE[start]


def sesh_picker_session_order():
    try:
        result = subprocess.run(
            tmux_command("list-sessions", "-F", "#{session_last_attached} #S"),
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
    except Exception:
        return []
    if result.returncode != 0:
        return []
    sessions = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        timestamp, _, name = line.partition(" ")
        if not name or name.startswith("_"):
            continue
        try:
            attached_at = int(timestamp or "0")
        except ValueError:
            attached_at = 0
        sessions.append((attached_at, name))
    sessions.sort(key=lambda item: item[0], reverse=True)
    names = [name for _, name in sessions]
    # Match the sesh picker alt-tab ordering: previous session first, current second.
    if len(names) >= 2:
        names[0], names[1] = names[1], names[0]
    return names


_SESH_COLOUR_CACHE_KEY = None
_SESH_COLOUR_CACHE = None


def sesh_colour_map(extra_sessions):
    global _SESH_COLOUR_CACHE_KEY, _SESH_COLOUR_CACHE
    # Colors are deterministic per set of session names. Recomputing shells out
    # to `tmux list-sessions` plus one `cksum` per session, so cache by the
    # frozenset of session names and reuse across redraws. Only recompute when
    # the set changes (new/removed session).
    key = frozenset(extra_sessions)
    if key == _SESH_COLOUR_CACHE_KEY and _SESH_COLOUR_CACHE is not None:
        return _SESH_COLOUR_CACHE
    used_codes = []
    colors = {}
    ordered = []
    seen = set()
    for name in sesh_picker_session_order() + list(extra_sessions):
        if not name or name in seen:
            continue
        seen.add(name)
        ordered.append(name)
    for name in ordered:
        colors[name] = pick_sesh_colour(cksum_value(name), used_codes)
    _SESH_COLOUR_CACHE_KEY = key
    _SESH_COLOUR_CACHE = colors
    return colors


