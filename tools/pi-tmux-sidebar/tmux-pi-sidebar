def sync_frozen_registry(panes):
    live_keys = set()
    for pane in panes:
        if pane.live_omp or pane.freeze_state != "frozen" or not pane.freeze_resume_id:
            continue
        frozen_at = pane.frozen_at or pane.freeze_last_activity or str(int(time.time() * 1000))
        key = (pane.freeze_resume_id, frozen_at)
        live_keys.add(key)
        if _registry_synced.get(pane.freeze_resume_id) == frozen_at:
            continue
        try:
            result = subprocess.run(
                [
                    FREEZE_REGISTRY_HELPER,
                    "freeze",
                    pane.freeze_resume_id,
                    "--cwd",
                    pane.freeze_cwd or pane.path,
                    "--title",
                    pane.title,
                    "--at",
                    frozen_at,
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=2,
                check=False,
            )
            if result.returncode == 0:
                _registry_synced[pane.freeze_resume_id] = frozen_at
        except Exception:
            pass
    active_ids = {session_id for session_id, _frozen_at in live_keys}
    for session_id in set(_registry_synced) - active_ids:
        _registry_synced.pop(session_id, None)


