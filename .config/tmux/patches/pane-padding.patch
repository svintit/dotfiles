+/* Draw blank padding cells on one side of a pane for a single row. */
+static void
+screen_redraw_draw_pane_padding_side(struct screen_redraw_ctx *ctx,
+    struct window_pane *wp, int wx, u_int width, int wy, u_int py,
+    struct grid_cell *defaults)
+{
+	struct client		*c = ctx->c;
+	struct tty		*tty = &c->tty;
+	struct visible_ranges	*r;
+	struct visible_range	*ri;
+	u_int			 k, wxi;
+	int			 px, ox = ctx->ox;
+
+	if (width == 0)
+		return;
+	r = tty_check_overlay_range(tty, wx, wy, width);
+	r = screen_redraw_get_visible_ranges(wp, wx, wy, width, r);
+	for (k = 0; k < r->used; k++) {
+		ri = &r->ranges[k];
+		if (ri->nx == 0)
+			continue;
+		for (wxi = ri->px; wxi < ri->px + ri->nx; wxi++) {
+			if (!screen_redraw_is_visible(r, wxi))
+				continue;
+			px = wxi + ox;
+			if (px < 0 || (u_int)px >= tty->sx)
+				continue;
+			tty_cursor(tty, px, py);
+			tty_cell(tty, &grid_default_cell, defaults,
+			    &wp->palette, NULL);
+		}
+	}
+}
+
+/* Draw blank padding regions on both sides of a pane. */
+static void
+screen_redraw_draw_pane_padding(struct screen_redraw_ctx *ctx,
+    struct window_pane *wp)
+{
+	struct tty		*tty = &ctx->c->tty;
+	struct grid_cell	 defaults;
+	int			 pad = wp->padding;
+	int			 ox = ctx->ox, oy = ctx->oy;
+	int			 sy = tty->sy - ctx->statuslines;
+	int			 woy, wx_left, wx_right;
+	u_int			 j, wy, py;
+
+	if (pad <= 0 || !window_pane_visible(wp))
+		return;
+
+	if (ctx->statustop)
+		woy = ctx->statuslines;
+	else
+		woy = 0;
+
+	tty_default_colours(&defaults, wp);
+	wx_left = wp->xoff - pad;
+	wx_right = wp->xoff + wp->sx;
+
+	for (j = 0; j < wp->sy; j++) {
+		if (wp->yoff + (int)j < oy || wp->yoff + (int)j >= oy + sy)
+			continue;
+		wy = wp->yoff + j;
+		py = woy + wy - oy;
+		if (py >= tty->sy)
+			continue;
+		screen_redraw_draw_pane_padding_side(ctx, wp, wx_left, pad,
+		    wy, py, &defaults);
+		screen_redraw_draw_pane_padding_side(ctx, wp, wx_right, pad,
+		    wy, py, &defaults);
+	}
+}
