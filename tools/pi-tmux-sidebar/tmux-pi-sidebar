def _frozen_elapsed_display(frozen_at_str):
    try:
        ts = int(frozen_at_str)
    except (TypeError, ValueError):
        return ""
    if not ts:
        return ""
    seconds = max(0, int(time.time() * 1000) - ts) / 1000
    minutes = int(seconds // 60)
    if minutes < 1:
        return "Frozen for <1m"
    if minutes < 60:
        return f"Frozen for {minutes}m"
    hours = minutes // 60
    mins = minutes % 60
    if hours < 24:
        return f"Frozen for {hours}h {mins}m"
    days = hours // 24
    hrs = hours % 24
    return f"Frozen for {days}d {hrs}h {mins}m"

